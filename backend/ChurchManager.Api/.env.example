# Exemplo local. Este arquivo não é carregado automaticamente pelo ASP.NET Core.
# O docker-compose.yml inicia MySQL na porta 3307.
CHURCHMANAGER_DB_PROVIDER=mysql
CHURCHMANAGER_DB=Server=localhost;Port=3307;Database=churchmanager;User=churchmanager;Password=churchmanager_local_dev;

# PostgreSQL remoto (somente como variável de ambiente do serviço; nunca comite a senha):
# CHURCHMANAGER_DB_PROVIDER=postgres
# ConnectionStrings__DefaultConnection=postgresql://USUARIO:SENHA@HOST:5432/BASE
# JWT_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
# FRONTEND_ORIGIN=https://seu-site.onrender.com
# Database__AutoCreate=true  (somente para iniciar uma base nova e vazia)
# AUTH_ALLOW_PUBLIC_REGISTRATION=true
