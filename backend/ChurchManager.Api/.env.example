# Configuração local de acesso ao PostgreSQL do Supabase.
# Copie os dados de Supabase > Connect > Session pooler.
# Mantenha a senha fora do repositório; prefira User Secrets.
CHURCHMANAGER_DB_PROVIDER=postgres
ConnectionStrings__DefaultConnection=Host=HOST_DO_POOLER;Port=5432;Database=postgres;Username=USUARIO_DO_POOLER;Password=SUA_SENHA;SSL Mode=Require
JWT_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
FRONTEND_ORIGIN=https://churchmanager-tcc.onrender.com
AUTH_ALLOW_PUBLIC_REGISTRATION=false
Database__AutoCreate=false
