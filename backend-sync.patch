diff --git a/backend/ChurchManager.Api/.env.example b/backend/ChurchManager.Api/.env.example
index 7154a77..08ae3aa 100644
--- a/backend/ChurchManager.Api/.env.example
+++ b/backend/ChurchManager.Api/.env.example
@@ -1,12 +1,26 @@
-# Exemplo local. Este arquivo não é carregado automaticamente pelo ASP.NET Core.
-# O docker-compose.yml inicia MySQL na porta 3307.
-CHURCHMANAGER_DB_PROVIDER=mysql
-CHURCHMANAGER_DB=Server=localhost;Port=3307;Database=churchmanager;User=churchmanager;Password=churchmanager_local_dev;
-
-# PostgreSQL remoto (somente como variável de ambiente do serviço; nunca comite a senha):
-# CHURCHMANAGER_DB_PROVIDER=postgres
-# ConnectionStrings__DefaultConnection=postgresql://USUARIO:SENHA@HOST:5432/BASE
-# JWT_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
-# FRONTEND_ORIGIN=https://seu-site.onrender.com
-# Database__AutoCreate=true  (somente para iniciar uma base nova e vazia)
-# AUTH_ALLOW_PUBLIC_REGISTRATION=true
+# ChurchManager API — Exemplo de Variáveis de Ambiente (.env.example)
+# Nunca coloque credenciais reais ou senhas neste arquivo ou no repositório Git.
+
+# Provedor oficial de banco de dados (único da versão final: PostgreSQL)
+CHURCHMANAGER_DB_PROVIDER=postgres
+
+# Conexão com o PostgreSQL do Supabase (URL ou String de Conexão Npgsql):
+# Exemplo Session Mode / Direct connection:
+ConnectionStrings__DefaultConnection=Host=db.PROJECT_REF.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=SEGREDO_AQUI;SSL Mode=Require;Trust Server Certificate=true;
+
+# Chave secreta JWT (mínimo de 32 caracteres exclusivos e aleatórios)
+JWT_KEY=substitua-por-uma-chave-aleatoria-forte-com-mais-de-32-chars
+
+# Emissor e audiência do JWT
+JWT_ISSUER=ChurchManager.Api
+JWT_AUDIENCE=ChurchManager.Web
+
+# Origem HTTPS exata do Frontend no Vercel (sem barra final)
+FRONTEND_ORIGIN=https://churchmanager.vercel.app
+
+# Controle de cadastro administrativo público
+# Defina como false após a criação da conta administrativa inicial
+AUTH_ALLOW_PUBLIC_REGISTRATION=false
+
+# Controle de execução automática de migrações EF Core na inicialização
+Database__AutoMigrate=false
