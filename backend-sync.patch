+
+        // Conjunto de identificadores válidos para matching de participante na escala
+        var validIdentifiers = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        if (!string.IsNullOrWhiteSpace(currentName)) validIdentifiers.Add(currentName);
+        if (!string.IsNullOrWhiteSpace(currentEmail)) validIdentifiers.Add(currentEmail);
+        if (memberRecord != null)
+        {
+            if (!string.IsNullOrWhiteSpace(memberRecord.Name)) validIdentifiers.Add(memberRecord.Name);
+            if (!string.IsNullOrWhiteSpace(memberRecord.Email)) validIdentifiers.Add(memberRecord.Email);
+            validIdentifiers.Add(memberRecord.Id.ToString());
+        }
 
