+    [HttpGet("profile")]
+    [HttpGet("me")]
+    public async Task<IActionResult> GetProfile(CancellationToken cancellationToken)
+    {
+        if (CurrentChurchId is not int churchId) return Unauthorized();
+
+        var currentEmail = (User.FindFirstValue(ClaimTypes.Email) ?? string.Empty).Trim().ToLowerInvariant();
+        var currentName = (User.FindFirstValue(ClaimTypes.Name) ?? string.Empty).Trim();
+        var currentRole = User.FindFirstValue(ClaimTypes.Role) ?? "Membro";
+
+        var member = await db.Members.AsNoTracking()
+            .FirstOrDefaultAsync(m => m.ChurchId == churchId && !string.IsNullOrEmpty(currentEmail) && m.Email.ToLower() == currentEmail, cancellationToken)
+            ?? await db.Members.AsNoTracking()
+            .FirstOrDefaultAsync(m => m.ChurchId == churchId && m.Name.ToUpper() == currentName.ToUpper(), cancellationToken);
+
+        return Ok(new
+        {
+            name = member?.Name ?? currentName,
+            email = member?.Email ?? currentEmail,
+            phone = member?.Phone ?? "",
+            ministry = member?.Ministry ?? "",
+            role = member?.Role ?? currentRole,
+            status = member?.Status ?? "Ativo"
+        });
+    }
+
